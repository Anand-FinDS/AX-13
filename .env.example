# =====================================================================
# AX-13 — environment template
# Copy to .env (gitignored) and fill in. Never commit .env.
# Rule: everything runs locally except LLM API calls (CLAUDE.md §1).
# =====================================================================

# ---- Run settings ----------------------------------------------------
AX13_ENV=dev                      # dev | demo
AX13_SEED=13                      # global seed for the synthetic dataset

# ---- LLMs (called through LiteLLM; provider prefix required) ---------
OPENAI_API_KEY=
GROQ_API_KEY=

# Model roles. Run `python scripts/check_connections.py --list-models`
# to see what your keys can access, then pin exact model ids here.
AX13_MODEL_REASON=openai/<pin-strong-model>      # scoring reasoning, drafting, LLM judge
AX13_MODEL_EXTRACT=groq/<pin-fast-open-model>    # VoiceCore extraction, classification
AX13_MODEL_FALLBACK=openai/<pin-cheaper-model>   # used when the primary is rate-limited or down

# Embeddings for the playbook/catalogue RAG (Phase 2).
# Changing this later means re-creating the Qdrant collection (vector size changes).
AX13_EMBED_MODEL=openai/text-embedding-3-small

# ---- Postgres (local Docker) -----------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ax13
POSTGRES_USER=ax13
POSTGRES_PASSWORD=ax13_local
# Restricted login used only by mcp_servers/ (read/write on ax13, no access to ax13_eval).
# data/load_postgres.py creates/updates this role on every load.
POSTGRES_MCP_USER=ax13_mcp
POSTGRES_MCP_PASSWORD=ax13_mcp_local

# ---- Qdrant -----------------------------------------------------------
# Default: local Docker (works without venue Wi-Fi).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# To use Qdrant Cloud instead, set:
# QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io:6333
# QDRANT_API_KEY=<cloud key>

# ---- OpenTelemetry -> Grafana LGTM (local Docker, no account) ----------
OTEL_SERVICE_NAME=ax13
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
GRAFANA_URL=http://localhost:3000

# ---- LangSmith (development debugging only; off for the demo) ---------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ax13-dev

# ---- Voice (Phase 4) -------------------------------------------------
# Hugging Face token: needed for pyannote diarisation (gated model —
# accept the model terms on its HF page with the same account).
HF_TOKEN=
# Optional, only if Indic ASR via Sarvam is chosen after the clip tests.
SARVAM_API_KEY=
